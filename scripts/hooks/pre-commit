#!/usr/bin/env bash
# Pre-commit gate: the explore page's only automated check, made structural.
#
# Brief 9/30 (Klatch/Argus): a discipline that depends on remembering to run
# a check is not a discipline; when the check is fast and stateless, make it a
# pre-commit gate. check_explore_syntax.py is ~0.2s, no network, exit 0/1/2/3,
# and until now I ran it by hand each fire. Only fires when the page is staged,
# so unrelated commits are not gated.
#
# Wired with `git config core.hooksPath scripts/hooks`. That is repo-local
# config — fine HERE because globe is a single-seat checkout. Never do this in
# mediajunkie or designinproduct (see memory: shared-checkout-identity).
#
# Exec bit is set via `git update-index --chmod=+x` so it survives clones; a
# non-executable hook is silently ignored by git (the brief's gotcha).
set -euo pipefail
# Full-read grep, not grep -q: under pipefail an early exit can SIGPIPE the
# producer and fail the pipeline, and in an `if` that reads as "not staged" —
# the gate would silently skip. Fail-open is the wrong direction for a gate.
# (Brief 10/02, Pard's freeze-check: the -q optimisation is the hazard.)
# Gate EVERY staged .html that carries an inline script, not one hardcoded path
# (brief 10/06 finding 2: a hardcoded name is a coverage claim for one file).
# --no-renames on every staged-file read (brief 11-02, Piper Morgan CIO: a guard
# must cover every form of the operation it gates): without it git reports a
# `git mv` as R, which none of the A/M/D filters below select, so a renamed
# keyframe, page or log skipped its gate. Proven in a scratch clone 2026-11-02:
# `git mv 0050ma.webp 0051ma.webp` committed clean under the old hook.
# Brief 11-24 (Klatch units 509/510): git quotes any path with a non-ASCII byte
# in --name-only output — "caf\303\251 plate.mp4", literal double quotes — so a
# newline reader holds a name that exists nowhere. The html and log filters
# below would not match it and the size gate's `[ -f ]` would skip it: three
# gates passing a file they never read, at exit 0. Proven on this hook as
# committed, 2026-11-24: a 100 MiB "café plate.mp4" committed clean. Every
# staged-file read is now -z (never quoted), NUL turned to newline for the grep
# filters, and names reach the checkers as separate arguments via xargs -0, so
# a space in a name does not split it either. Tested by test_size_gate.sh (E)
# and test_manifest_gate.sh (C2).
names() { git diff --cached --no-renames --name-only -z --diff-filter="$1" | tr '\0' '\n'; }
staged=$(names AM | grep -E '\.html$' || true)
if [ -n "$staged" ]; then
  printf '%s\n' "$staged" | tr '\n' '\0' | xargs -0 python3 scripts/check_explore_syntax.py || {
    echo "pre-commit: a staged HTML page failed its script syntax gate — commit refused." >&2
    exit 1
  }
fi

# Explore manifest gate (brief 10-26): when a keyframe manifest or asset is
# staged, every declared file must be present in the index-to-be. Checks the
# working tree (the hook runs before the commit object exists); a declared file
# that exists on disk but is not staged is caught by the fire check's Pages
# proof, not here.
# Full-read grep, not -q (same SIGPIPE/pipefail hazard as the syntax gate above).
assets_staged=$(names AMD | grep -E '^scrubber_assets/' || true)
if [ -n "$assets_staged" ]; then
  # Manifests derived from the index-to-be, not a typed list — brief 11-09.
  # The derivation lives in scripts/explore_manifests.sh, shared with the fire
  # check (brief 11-10: the rule itself was a hand-typed copy in two places).
  # An empty list refuses by name rather than skipping: assets are staged but
  # nothing declares them. Tested by scripts/test_manifest_gate.sh.
  manifests=$(bash scripts/explore_manifests.sh)
  [ -n "$manifests" ] || { echo "pre-commit: scrubber_assets/ is staged but no Explore manifest (scrubber_assets/*.json) is tracked — nothing declares these assets; commit refused." >&2; exit 1; }
  printf '%s\n' "$manifests" | tr '\n' '\0' | xargs -0 python3 scripts/check_explore_manifest.py || {
    echo "pre-commit: a staged Explore manifest declares a keyframe that is not on disk — commit refused." >&2; exit 1
  }
fi

# Size gate: GitHub refuses any blob of 100 MiB or more, and a refused push is
# how the site stops updating without a visible failure. Films are the only
# legitimate large files here (tectonic_flat_v8.mp4 is 95.8 MiB — close). The
# limit is the host's, so the number is not a judgement call.
while IFS= read -r f; do
  [ -f "$f" ] || continue
  sz=$(stat -f %z "$f" 2>/dev/null || stat -c %s "$f")
  if [ "$sz" -ge 104857600 ]; then
    echo "pre-commit: $f is $((sz/1048576)) MiB — GitHub refuses blobs of 100 MiB or more; commit refused (re-encode or host it elsewhere)." >&2; exit 1
  fi
done < <(names AM)

# Drain guard (xian's rule via Janus, 2026-10-08: "the fire is a wake, not a
# time-box" — designinproduct/docs/conventions/duty-cycle-drain.md). Every NEW
# entry (any "## " heading) added to a tessera log must carry a "Drain:" line,
# and a Drain line that defers work must name a blocker. The check lives in
# scripts/check_drain.sh (tested by scripts/test_check_drain.sh against real
# headings — brief 10-19: the old "## HH:MM PT" opener matched nothing once
# the headings drifted, and eight entries passed unchecked). Only fires when
# a log is staged.
logs_staged=$(names AM | grep -E '^logs/.*-tessera-log\.md$' || true)
if [ -n "$logs_staged" ]; then
  printf '%s\n' "$logs_staged" | tr '\n' '\0' | xargs -0 git diff --cached -U0 -- | { grep -E '^\+' || true; } | { grep -vE '^\+\+\+' || true; } | sed 's/^+//' | bash scripts/check_drain.sh || {
    echo "pre-commit: drain guard refused the staged log entry (see above)." >&2; exit 1
  }
fi

# Log time gate (brief 11-19, Piper Morgan: "timestamps from the clock, not
# estimated" was a stated rule, broken by the agents who had filed it; as a
# commit-time refusal it had zero false refusals in its first 60 commits). The
# same rule has stood here since 10-21 as a remembered obligation. Per staged
# log, its added lines are read with the log's filename date: an estimated time
# ("~16:40", "13:0x"), a heading after the Pacific clock, or a filename dated
# after today is refused. Tested by scripts/test_check_log_times.sh.
if [ -n "$logs_staged" ]; then
  while IFS= read -r lf; do
    [ -n "$lf" ] || continue
    ld=$(basename "$lf" | grep -oE '^[0-9]{4}-[0-9]{2}-[0-9]{2}') || { echo "pre-commit: $lf carries no YYYY-MM-DD date in its name — the time gate cannot run; commit refused." >&2; exit 1; }
    git diff --cached -U0 -- "$lf" | { grep -E '^\+' || true; } | { grep -vE '^\+\+\+' || true; } | sed 's/^+//' | bash scripts/check_log_times.sh "$ld" || {
      echo "pre-commit: log time gate refused $lf (see above)." >&2; exit 1
    }
  done <<< "$logs_staged"
fi

# Handoff pointers at write time (brief 11-17, Klatch: a measurement typed into
# a slot is indistinguishable from one read from the output — check at the
# moment of writing). When the living handoff or any test script is staged,
# the pointer check runs, including pointer 6, which runs every test script
# the handoff puts a case count on and compares the typed count with the
# script's own summary line. Only fires when one of those files is staged.
ho_staged=$(names AM | grep -E '^(docs/handoff-tessera-2026-09-29\.md|scripts/test_[a-z_]+\.sh)$' || true)
if [ -n "$ho_staged" ]; then
  bash scripts/check_handoff_pointers.sh || {
    echo "pre-commit: the handoff's pointers disagree with the repo (see GAP lines above) — commit refused." >&2; exit 1
  }
fi
