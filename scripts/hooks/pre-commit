#!/usr/bin/env bash
# Pre-commit gate: the explore page's only automated check, made structural.
#
# Brief 9/30 (Klatch/Argus): a discipline that depends on remembering to run
# a check is not a discipline; when the check is fast and stateless, make it a
# pre-commit gate. check_explore_syntax.py is ~0.2s, no network, exit 0/1/2/3,
# and until now I ran it by hand each fire. Only fires when the page is staged,
# so unrelated commits are not gated.
#
# Wired with `git config core.hooksPath scripts/hooks`. That is repo-local
# config — fine HERE because globe is a single-seat checkout. Never do this in
# mediajunkie or designinproduct (see memory: shared-checkout-identity).
#
# Exec bit is set via `git update-index --chmod=+x` so it survives clones; a
# non-executable hook is silently ignored by git (the brief's gotcha).
set -euo pipefail
# Full-read grep, not grep -q: under pipefail an early exit can SIGPIPE the
# producer and fail the pipeline, and in an `if` that reads as "not staged" —
# the gate would silently skip. Fail-open is the wrong direction for a gate.
# (Brief 10/02, Pard's freeze-check: the -q optimisation is the hazard.)
# Gate EVERY staged .html that carries an inline script, not one hardcoded path
# (brief 10/06 finding 2: a hardcoded name is a coverage claim for one file).
staged=$(git diff --cached --name-only --diff-filter=AM | grep -E '\.html$' || true)
if [ -n "$staged" ]; then
  # shellcheck disable=SC2086
  python3 scripts/check_explore_syntax.py $staged || {
    echo "pre-commit: a staged HTML page failed its script syntax gate — commit refused." >&2
    exit 1
  }
fi

# Explore manifest gate (brief 10-26): when a keyframe manifest or asset is
# staged, every declared file must be present in the index-to-be. Checks the
# working tree (the hook runs before the commit object exists); a declared file
# that exists on disk but is not staged is caught by the fire check's Pages
# proof, not here.
# Full-read grep, not -q (same SIGPIPE/pipefail hazard as the syntax gate above).
assets_staged=$(git diff --cached --name-only --diff-filter=AMD | grep -E '^scrubber_assets/' || true)
if [ -n "$assets_staged" ]; then
  python3 scripts/check_explore_manifest.py scrubber_assets/keyframes.json scrubber_assets/future/keyframes-future.json || {
    echo "pre-commit: a staged Explore manifest declares a keyframe that is not on disk — commit refused." >&2; exit 1
  }
fi

# Size gate: GitHub refuses any blob of 100 MiB or more, and a refused push is
# how the site stops updating without a visible failure. Films are the only
# legitimate large files here (tectonic_flat_v8.mp4 is 95.8 MiB — close). The
# limit is the host's, so the number is not a judgement call.
while IFS= read -r f; do
  [ -f "$f" ] || continue
  sz=$(stat -f %z "$f" 2>/dev/null || stat -c %s "$f")
  if [ "$sz" -ge 104857600 ]; then
    echo "pre-commit: $f is $((sz/1048576)) MiB — GitHub refuses blobs of 100 MiB or more; commit refused (re-encode or host it elsewhere)." >&2; exit 1
  fi
done < <(git diff --cached --name-only --diff-filter=AM)

# Drain guard (xian's rule via Janus, 2026-10-08: "the fire is a wake, not a
# time-box" — designinproduct/docs/conventions/duty-cycle-drain.md). Every NEW
# entry (any "## " heading) added to a tessera log must carry a "Drain:" line,
# and a Drain line that defers work must name a blocker. The check lives in
# scripts/check_drain.sh (tested by scripts/test_check_drain.sh against real
# headings — brief 10-19: the old "## HH:MM PT" opener matched nothing once
# the headings drifted, and eight entries passed unchecked). Only fires when
# a log is staged.
logs_staged=$(git diff --cached --name-only --diff-filter=AM | grep -E '^logs/.*-tessera-log\.md$' || true)
if [ -n "$logs_staged" ]; then
  # shellcheck disable=SC2086
  git diff --cached -U0 -- $logs_staged | { grep -E '^\+' || true; } | { grep -vE '^\+\+\+' || true; } | sed 's/^+//' | bash scripts/check_drain.sh || {
    echo "pre-commit: drain guard refused the staged log entry (see above)." >&2; exit 1
  }
fi
