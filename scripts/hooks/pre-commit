#!/usr/bin/env bash
# Pre-commit gate: the explore page's only automated check, made structural.
#
# Brief 9/30 (Klatch/Argus): a discipline that depends on remembering to run
# a check is not a discipline; when the check is fast and stateless, make it a
# pre-commit gate. check_explore_syntax.py is ~0.2s, no network, exit 0/1/2/3,
# and until now I ran it by hand each fire. Only fires when the page is staged,
# so unrelated commits are not gated.
#
# Wired with `git config core.hooksPath scripts/hooks`. That is repo-local
# config — fine HERE because globe is a single-seat checkout. Never do this in
# mediajunkie or designinproduct (see memory: shared-checkout-identity).
#
# Exec bit is set via `git update-index --chmod=+x` so it survives clones; a
# non-executable hook is silently ignored by git (the brief's gotcha).
set -euo pipefail
# Full-read grep, not grep -q: under pipefail an early exit can SIGPIPE the
# producer and fail the pipeline, and in an `if` that reads as "not staged" —
# the gate would silently skip. Fail-open is the wrong direction for a gate.
# (Brief 10/02, Pard's freeze-check: the -q optimisation is the hazard.)
# Gate EVERY staged .html that carries an inline script, not one hardcoded path
# (brief 10/06 finding 2: a hardcoded name is a coverage claim for one file).
staged=$(git diff --cached --name-only --diff-filter=AM | grep -E '\.html$' || true)
if [ -n "$staged" ]; then
  # shellcheck disable=SC2086
  python3 scripts/check_explore_syntax.py $staged || {
    echo "pre-commit: a staged HTML page failed its script syntax gate — commit refused." >&2
    exit 1
  }
fi
